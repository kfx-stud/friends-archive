# ==============================================================================
# Google Gemini API Configuration
# ==============================================================================
# Пул ключей Google Gemini API через запятую для ускорения обработки (12 / N сек)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-3.8-flash

# Кастомный системный промпт (по умолчанию prompt.txt, если отсутствует — prompt.example.txt)
# CURATOR_PROMPT_FILE=prompt.txt

# ==============================================================================
# JSONBin.io Cloud Buffer Configuration
# ==============================================================================
# ID удаленного бина для очереди заявок
JSONBIN_BIN_ID=6abbe438ffd5d160533c11f1

# Приватный Master-Key для админки (чтение и сброс очереди заявок)
JSONBIN_API_KEY=$2a$10$your_private_master_key_here

# ==============================================================================
# Прокси (при необходимости обхода гео-блокировок Gemini API: HTTP или SOCKS5h)
# ==============================================================================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# Для SOCKS5 (Happ, Sing-box, v2ray, port 10808):
# HTTP_PROXY=socks5h://127.0.0.1:10808
# HTTPS_PROXY=socks5h://127.0.0.1:10808
